# === Zeebe connection ===
# Local (docker compose camunda-platform)
ZEEBE_ADDRESS=localhost:26500

# === Camunda 8 SaaS (optional) ===
# ZEEBE_CLIENT_ID=xxx
# ZEEBE_CLIENT_SECRET=xxx
# ZEEBE_AUTHORIZATION_SERVER_URL=https://login.cloud.camunda.io/oauth/token
# ZEEBE_AUDIENCE=zeebe.camunda.io
# ZEEBE_CLUSTER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZEEBE_ADDRESS=your-region.zeebe.camunda.io:443

# === Elasticsearch (for listing user tasks) ===
ES_URL=http://localhost:9200
# ES_USER=elastic
# ES_PASS=changeme

# === CORS origins (comma separated) ===
CORS_ORIGINS=*

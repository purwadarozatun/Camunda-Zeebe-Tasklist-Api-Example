# Camunda 8 WhatsApp Worker Configuration
# ======================================

# Zeebe Connection
ZEEBE_ADDRESS=localhost:26500

# Worker Configuration
JOB_TYPE=kirim-notifikasi-wa
WORKER_NAME=whatsapp-worker
MAX_JOBS=1
JOB_TIMEOUT=30000

# WhatsApp API Configuration (TODO: implement real API)
WHATSAPP_BASE_URL=https://api.whatsapp.com/send
WHATSAPP_TOKEN=your_whatsapp_token_here

# Logging
LOG_LEVEL=INFO